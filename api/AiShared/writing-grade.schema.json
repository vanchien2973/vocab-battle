          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "0-10 in steps of 0.5."
            },
            "comment": {
              "type": "string",
              "description": "2-4 specific sentences in Vietnamese."
            },
            "evidence": {
              "type": "array",
              "description": "1-3 short quotes copied exactly from the essay.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "comment",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "0-10 in steps of 0.5."
            },
            "comment": {
              "type": "string",
              "description": "2-4 specific sentences in Vietnamese."
            },
            "evidence": {
              "type": "array",
              "description": "1-3 short quotes copied exactly from the essay.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "grammar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "comment",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "0-10 in steps of 0.5."
            },
            "comment": {
              "type": "string",
              "description": "2-4 specific sentences in Vietnamese."
            },
            "evidence": {
              "type": "array",
              "description": "1-3 short quotes copied exactly from the essay.",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "overallScore": {
      "type": "number",
      "description": "Your estimate of the task score (the app recomputes it)."
    },
    "errors": {
      "type": "array",
      "description": "Concrete mistakes, most important first, at most 40.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "occurrence",
          "category",
          "rule",
          "severity",
          "correction",
          "explanationVi"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "description": "The shortest wrong span, copied character for character from the essay."
          },
          "occurrence": {
            "type": "integer",
            "description": "Which occurrence of this exact quote in the essay (1 = first)."
          },
          "category": {
            "type": "string",
            "enum": [
              "grammar",
              "vocabulary",
              "spelling",
              "punctuation",
              "coherence",
              "task",
              "register"
            ]
          },
          "rule": {
            "type": "string",
            "enum": [
              "verb_tense",
              "subject_verb",
              "article",
              "preposition",
              "plural",
              "word_form",
              "word_order",
              "sentence_structure",
              "collocation",
              "word_choice",
              "spelling",
              "punctuation",
              "linking",
              "register",
              "content",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "major"
            ]
          },
          "correction": {
            "type": "string",
            "description": "Corrected replacement for the quote."
          },
          "explanationVi": {
            "type": "string",
            "description": "Short explanation in Vietnamese."
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "description": "Up to 3, Vietnamese, specific.",
      "items": {
        "type": "string"
      }
    },
    "improvements": {
      "type": "array",
      "description": "Up to 3, Vietnamese, specific and actionable.",
      "items": {
        "type": "string"
      }
    }
  }
}