{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criteria",
    "overallScore",
    "errors",
    "strengths",
    "improvements"
  ],
  "properties": {
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskFulfilment",
        "organization",
        "vocabulary",
        "grammar"
      ],
      "properties": {
        "taskFulfilment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "comment",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "0-10 in steps of 0.5."
            },
            "comment": {
              "type": "string",
              "description": "2-4 specific sentences in Vietnamese."
            },
            "evidence": {
              "type": "array",
              "description": "1-3 short quotes copied exactly from the essay.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
