{
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "items"],
  "properties": {
    "name": { "type": "string", "description": "Short deck name in Vietnamese." },
    "description": { "type": "string", "description": "One sentence in Vietnamese." },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "meaning", "partOfSpeech", "ipa", "examples", "note"],
        "properties": {
          "type": { "type": "string", "enum": ["word", "collocation", "phrasal_verb", "idiom", "pattern"] },
          "text": { "type": "string" },
          "meaning": { "type": "string", "description": "Short Vietnamese meaning." },
          "partOfSpeech": { "type": "string" },
          "ipa": { "type": "string" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["en", "vi"],
              "properties": { "en": { "type": "string" }, "vi": { "type": "string" } }
            }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
